Cabal-version:      3.0

name:               invoker-steam
version:            0.0.0.1

build-type:         Simple
license:            BSD-3-Clause

common exts
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    RecordWildCards
    OverloadedRecordDot
    NoFieldSelectors

Flag dev
  Description: Dumps Core representation
  Default:     False
  Manual:      True

Library
  import: exts
  default-language: GHC2021
  exposed-modules:
    Invoker.Steam
  other-modules:
    Invoker.Steam.ConnectionManager
    Invoker.Steam.Crypto
    Invoker.Steam.Packets.Handshake
    Invoker.Steam.Packets.Internal
    Invoker.Steam.Packets.LogOn
  hs-source-dirs:
    ./library/
  ghc-options:
    -Wall
    -Wunused-packages
  build-depends:
    -- GHC included libraries
      base >= 4.7 && <5
    , bytestring

    -- Internal
    , binary-buff
    , invoker-steam-proto

    -- External
    , aeson
    , http-client

    , ram
    , crypton >= 1.1
    , crypton-pem >= 0.3
    , crypton-x509
    , crypton-asn1-encoding
    , digest
  if flag(dev)
    GHC-Options:
      -ddump-to-file
      -ddump-timings
      -ddump-simpl
      -ddump-spec
      -ddump-simpl-stats
      -ddump-rule-firings
      -dsuppress-all
      -dsuppress-uniques
    if impl(ghc >= 9.4)
      ghc-options:
        -dlint
        -dno-suppress-core-sizes
