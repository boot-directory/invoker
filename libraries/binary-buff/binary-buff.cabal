Cabal-version:      3.0

name:               binary-buff
version:            0.0.0.1

build-type:         Simple
license:            BSD-3-Clause

common exts
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    RecordWildCards
    OverloadedRecordDot
    NoFieldSelectors

Flag dev
  Description: Dumps Core representation
  Default:     False
  Manual:      True

Library
  import: exts
  default-language: GHC2021
  exposed-modules:
    BinaryBuff
  other-modules:
  hs-source-dirs:
    ./library/
  ghc-options:
    -Wall
    -Wunused-packages
  build-depends:
    -- GHC included libraries
      base >= 4.7 && <5
    , binary
    , bytestring
    , mtl

    -- External dependencies
    , network < 4

  if flag(dev)
    GHC-Options:
      -ddump-to-file
      -ddump-timings
      -ddump-simpl
      -ddump-spec
      -ddump-simpl-stats
      -ddump-rule-firings
      -dsuppress-all
      -dsuppress-uniques
    if impl(ghc >= 9.4)
      ghc-options:
        -dlint
        -dno-suppress-core-sizes
